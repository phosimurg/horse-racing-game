{
  "name": "horse-racing-game",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive horse racing game built with Vue 3, TypeScript and Pinia",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint lint:style",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --max-warnings=0 --cache",
    "lint:style": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache && stylelint \"src/**/*.{css,vue}\" --fix --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:docker": "docker run --rm --init --ipc=host -e HUSKY=0 -v \"$PWD\":/work -v horse-racing-game-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.63.0-noble /bin/bash -c \"npm ci && npm run test:visual\"",
    "test:visual:update": "docker run --rm --init --ipc=host -e HUSKY=0 -v \"$PWD\":/work -v horse-racing-game-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.63.0-noble /bin/bash -c \"npm ci && npm run test:visual -- --update-snapshots\"",
    "traceability": "node scripts/check-traceability.mjs",
    "verify": "run-s lint format:check type-check test:coverage build-only traceability",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@pinia/testing": "2.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-vue": "10.11.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.82.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
